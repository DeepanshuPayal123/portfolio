---
import SectionHeader from '@/components/SectionHeader.astro';
import RaftDemo from '@/islands/RaftDemo';
---

<section id="consensus" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
  <SectionHeader
    label="Live system"
    title="Crash the leader."
    note="A real Raft cluster is running in your browser — the consensus protocol behind etcd and Kubernetes. Kill any server and watch the survivors agree on a new leader."
  />

  <div data-reveal class="frame mt-10 p-4 sm:p-8">
    <RaftDemo client:visible />
  </div>

  <p class="mono-label mt-4">
    The protocol I studied hands-on in LOCKSTEP · deterministic simulation, entirely in your browser
  </p>
</section>

<style is:global>
  .raft-stage {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }
  .raft-ring {
    fill: none;
    stroke: var(--line-strong);
    stroke-dasharray: 2 7;
  }
  .raft-core {
    fill: color-mix(in oklab, var(--accent) 7%, transparent);
    stroke: var(--line);
  }
  .raft-caption {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.06em;
  }
  .raft-caption.is-dim {
    fill: var(--ink-dim);
    font-size: 12px;
    text-transform: uppercase;
  }
  .raft-mesh {
    stroke: var(--line);
    stroke-width: 1;
  }
  .raft-timer {
    fill: none;
    stroke: var(--ink-dim);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.4;
  }
  .raft-timer.is-low {
    stroke: var(--amber);
    opacity: 0.9;
  }
  .raft-ripple {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .raft-entry {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .raft-entry.is-committed {
    fill: var(--accent);
  }

  .raft-node {
    position: absolute;
    display: grid;
    aspect-ratio: 1;
    place-content: center;
    gap: 1px;
    transform: translate(-50%, -50%);
    border: 1px solid var(--line-strong);
    border-radius: 9999px;
    background:
      radial-gradient(circle at 50% 28%, color-mix(in oklab, var(--ink) 9%, transparent), transparent 70%),
      var(--glass);
    backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 var(--glass-edge);
    color: var(--ink);
    text-align: center;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }
  .raft-node:hover {
    border-color: var(--accent);
  }
  .raft-node:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .raft-node-id {
    font-size: clamp(0.8rem, 2.4vw, 1rem);
    font-weight: 600;
  }
  .raft-node-role {
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .raft-node[data-role='leader'] {
    border-color: var(--accent);
    background:
      radial-gradient(circle at 50% 28%, color-mix(in oklab, var(--highlight) 30%, transparent), transparent 70%),
      color-mix(in oklab, var(--accent) 24%, var(--glass));
    box-shadow:
      0 0 0 1px var(--accent),
      0 0 36px var(--glow);
  }
  .raft-node[data-role='leader'] .raft-node-role {
    color: var(--accent);
  }
  .raft-node[data-role='candidate'] {
    border-color: var(--amber);
    animation: raft-pulse 1s ease-in-out infinite;
  }
  .raft-node[data-role='candidate'] .raft-node-role {
    color: var(--amber);
  }
  .raft-node[data-role='down'] {
    border-style: dashed;
    border-color: var(--err);
    opacity: 0.55;
  }
  .raft-node[data-role='down'] .raft-node-role {
    color: var(--err);
  }
  .raft-crown {
    position: absolute;
    top: -1.2em;
    left: 50%;
    transform: translateX(-50%);
    color: var(--accent);
    font-size: 0.8rem;
  }
  .raft-event:first-child {
    animation: raft-in var(--dur) var(--ease-out);
  }

  @keyframes raft-pulse {
    50% {
      box-shadow: 0 0 0 6px color-mix(in oklab, var(--amber) 22%, transparent);
    }
  }
  @keyframes raft-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (max-width: 30rem) {
    /* Too small to read inside the circle; colour and the button's name carry the role. */
    .raft-node-role {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .raft-node[data-role='candidate'],
    .raft-event:first-child {
      animation: none;
    }
  }
</style>
