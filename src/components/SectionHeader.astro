---
interface Props {
  /** Short eyebrow shown in the pill, e.g. "Experience". */
  label: string;
  /** The section's heading. */
  title: string;
  note?: string;
}

const { label, title, note } = Astro.props;
---

<div data-reveal class="max-w-3xl">
  <p class="pill-label">{label}</p>
  <h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h2>
  {note && <p class="mt-3 text-base text-dim sm:text-lg">{note}</p>}
</div>
