---
import Icon from '@/components/Icon.astro';
import type { Project } from '@/data/site';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
---

<article id={project.id} data-reveal class:list={['frame flex flex-col p-6 sm:p-8', className]}>
  <p class="mono-label">{project.kind}</p>
  <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-2xl font-semibold tracking-tight">{project.name}</h3>
    <p class="mono-label">{project.period}</p>
  </div>
  <p class="mt-3 leading-relaxed text-dim">{project.summary}</p>

  <ul class="mt-5 space-y-3 leading-relaxed">
    {
      project.points.map((p) => (
        <li class="flex gap-3">
          <span class="mt-2.5 size-1.5 shrink-0 bg-accent" aria-hidden="true" />
          <span>{p}</span>
        </li>
      ))
    }
  </ul>

  <slot />

  <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-6">
    <ul class="flex flex-wrap gap-2" aria-label={`${project.name} stack`}>
      {project.stack.map((s) => <li class="chip">{s}</li>)}
    </ul>
    <a
      href={project.source}
      class="inline-flex items-center gap-2 font-mono text-sm text-accent hover:underline"
      aria-label={`${project.name} source on GitHub`}
    >
      Source <Icon name="external" class="size-3.5" />
    </a>
  </div>
</article>
