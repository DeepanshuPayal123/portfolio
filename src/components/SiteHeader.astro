---
import ThemeToggle from '@/components/ThemeToggle.astro';

const sections = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-paper/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="font-mono text-sm tracking-[0.2em]">DEEPANSHU<span class="text-accent">/</span>SDE</a>
    <div class="flex items-center gap-6">
      <nav aria-label="Sections" class="hidden items-center gap-6 sm:flex">
        {sections.map((s) => <a href={s.href} class="mono-label transition-colors hover:text-accent">{s.label}</a>)}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
