---
import { site } from '@/data/site';
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-8 sm:px-6">
    <p class="mono-label">© 2026 {site.name}</p>
    <p class="mono-label">
      Earth imagery{' '}
      <a href="https://visibleearth.nasa.gov/" class="underline underline-offset-4 hover:text-accent">NASA</a>{' '}
      · Built with Astro · static · no trackers
    </p>
  </div>
</footer>
