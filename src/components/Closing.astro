---
import { site } from '@/data/site';
---

<section
  id="closing"
  class="relative mx-auto flex min-h-[80svh] max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:px-6"
>
  <h2 data-reveal class="text-4xl font-semibold tracking-tight sm:text-6xl">
    Thanks for <span class="text-gradient">visiting</span>
  </h2>
  <p data-reveal class="mt-4 text-dim sm:text-lg">If something here resonated, I'd love to hear from you.</p>

  <svg data-signature aria-hidden="true" viewBox="0 0 420 130" class="signature mt-10 w-72 sm:w-96">
    <text x="50%" y="80" text-anchor="middle">{site.name}</text>
    <path class="flourish" d="M80 106 C 170 92, 270 120, 350 98"></path>
  </svg>
</section>

<style>
  .signature text {
    font-family: var(--font-hand);
    font-size: 92px;
    font-weight: 600;
    fill: var(--ink);
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-dasharray: 900;
    stroke-dashoffset: 0;
    fill-opacity: 1;
  }
  .signature .flourish {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 0;
  }

  /* Written stroke by stroke once in view, then the ink fills in. */
  @media (prefers-reduced-motion: no-preference) {
    .signature:not([data-drawn]) text {
      stroke-dashoffset: 900;
      fill-opacity: 0;
    }
    .signature:not([data-drawn]) .flourish {
      stroke-dashoffset: 320;
    }
    .signature[data-drawn] text {
      animation:
        sign 2.4s var(--ease-out) both,
        ink 0.8s ease 1.8s both;
    }
    .signature[data-drawn] .flourish {
      animation: flourish 0.9s var(--ease-out) 2.1s both;
    }
  }

  @keyframes sign {
    from {
      stroke-dashoffset: 900;
    }
  }
  @keyframes ink {
    from {
      fill-opacity: 0;
    }
  }
  @keyframes flourish {
    from {
      stroke-dashoffset: 320;
    }
  }
</style>

<script>
  // Starts the signature when it scrolls into view; reduced motion shows it already written.
  const signature = document.querySelector<SVGSVGElement>('[data-signature]');
  if (signature) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      signature.dataset.drawn = 'true';
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          signature.dataset.drawn = 'true';
          observer.disconnect();
        },
        { threshold: 0.4 },
      );
      observer.observe(signature);
    }
  }
</script>
