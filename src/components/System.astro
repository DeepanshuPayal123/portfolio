---
import BlueprintDiagram from '@/components/BlueprintDiagram.astro';
import SectionHeader from '@/components/SectionHeader.astro';
---

<section id="system" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
  <SectionHeader
    label="System view"
    title="My path, drawn as a system"
    note="Every node links to its section. Watch the packets move through it."
  />
  <div data-reveal class="frame mt-10 p-5 sm:p-10">
    <div class="mx-auto max-w-4xl">
      <BlueprintDiagram />
    </div>
  </div>
</section>
