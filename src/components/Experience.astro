---
import SectionHeader from '@/components/SectionHeader.astro';
import { site } from '@/data/site';
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
  <SectionHeader sheet="02" title="Experience" note="Internships · 2025–2026" />

  <ol class="relative mt-10 space-y-8 border-l border-line pl-6 sm:pl-10">
    {
      site.experience.map((job) => (
        <li class="relative">
          <span
            class="absolute top-7 -left-[1.9rem] size-3 rotate-45 border border-accent bg-paper sm:-left-[2.9rem]"
            aria-hidden="true"
          />
          <article
            id={`job-${job.company.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            data-reveal
            class="frame p-6 sm:p-8"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-xl font-semibold">
                {job.company}
                <span class="font-normal text-dim"> · {job.role}</span>
              </h3>
              <p class="mono-label">
                {job.period} · {job.location}
              </p>
            </div>
            <p class="mt-2 text-dim">{job.summary}</p>

            <dl class="mt-6 grid gap-4 sm:grid-cols-2">
              {job.metrics.map((m) => (
                <div class="flex flex-col-reverse border-l-2 border-accent pl-4">
                  <dt class="mono-label mt-1">{m.label}</dt>
                  <dd class="font-mono text-2xl text-accent">{m.value}</dd>
                </div>
              ))}
            </dl>

            <ul class="mt-6 space-y-3 leading-relaxed">
              {job.points.map((p) => (
                <li class="flex gap-3">
                  <span class="mt-2.5 size-1.5 shrink-0 bg-accent" aria-hidden="true" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>

            <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${job.company} stack`}>
              {job.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</section>
